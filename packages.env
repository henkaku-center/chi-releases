# Pinned Chi beta package refs (single source of truth).
# Sourced by scripts/smoke-dev-exe.sh and referenced by docs/BOOTSTRAP.md.
#
# During beta these are private GitHub repos; `gh auth setup-git` must be run
# before `pi install` so git-over-HTTPS clones authenticate.
#
# To pin a specific commit for a workshop, append "#<sha-or-tag>" to the URL
# once the Pi installer supports ref pinning; until then, record the expected
# sha in CHI_*_SHA and the smoke script will report (but not enforce) drift.

CHI_PACKAGES=(
  "https://github.com/henkaku-center/chi-base"
  "https://github.com/henkaku-center/chi-buzz"
  "https://github.com/henkaku-center/chi-sync"
  "https://github.com/henkaku-center/chi-commons"
)

# Optional expected shas (leave empty to skip drift check):
CHI_BASE_SHA=""
CHI_BUZZ_SHA=""
CHI_SYNC_SHA=""
CHI_COMMONS_SHA=""

# Minimum tool versions for the workshop environment.
MIN_NODE_MAJOR=20
